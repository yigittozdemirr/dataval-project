# DataVal.ai — Environment Configuration
# Copy this file as .env and fill in your values.

SECRET_KEY=CHANGE-ME-generate-a-real-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Leave empty for SQLite (default), or set a PostgreSQL URL for production
DATABASE_URL=

FRONTEND_URL=http://localhost,http://127.0.0.1
BACKEND_URL=http://localhost:8000

WORKER_THREADS=4

# Google OAuth (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
