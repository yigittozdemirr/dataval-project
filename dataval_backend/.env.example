# ─────────────────────────────────────────────────────────────────────────────
# DataVal.ai — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in REAL values before running in production.
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# The .env.example file (with placeholder values) IS safe to commit.
# ─────────────────────────────────────────────────────────────────────────────


# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-in-production

# JWT algorithm — HS256 is recommended; RS256 if you need asymmetric keys.
ALGORITHM=HS256

# JWT token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required for production).
# Leave empty to fall back to local SQLite (dataval.db) for development.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://dataval_user:strongpassword@localhost:5432/dataval_db

# PostgreSQL connection pool settings (optional — these are the defaults)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your production domain(s) alongside the local dev server.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Public URL of the backend — used to construct OAuth redirect URIs.
# Must match the Redirect URI registered in Google & GitHub OAuth app settings.
BACKEND_URL=http://localhost:8000


# ── Worker threads ────────────────────────────────────────────────────────────
# Number of threads in the ThreadPoolExecutor for ML analysis tasks.
WORKER_THREADS=4


# ── OAuth2 — Google ───────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ── OAuth2 — GitHub ───────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL to register: {BACKEND_URL}/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

